# /opt/cc-livestock/.env on the droplet (chmod 600). Generated there by README step 3; never commit the real one.
# --- database (the db container creates it with these on first start; DB_USER is the owner, used for migrations) ---
DB_USER=cc
DB_PASSWORD=            # openssl rand -hex 24
DB_NAME=cc_livestock
# The app runs as this restricted account (rows only); `cc db-role` creates it and fills both lines.
APP_DB_USER=cc_app
APP_DB_PASSWORD=        # openssl rand -hex 24 (cc db-role makes one when empty)
# --- farm app + API ---
JWT_SECRET=             # openssl rand -hex 32 (at least 32 characters)
CORS_ORIGIN=https://digital.camcow.com.kh
TRUST_PROXY=uniquelocal # believe Caddy (Docker's private network) about the visitor's address and https
NEXT_PUBLIC_APP_URL=https://digital.camcow.com.kh
WEBSITE_API_KEY=        # openssl rand -hex 32; the website uses the same value (CAMCOW_API_KEY)
# SESSION_COOKIE_SECURE=true   # set after HTTPS works (phase 2)
# ANTHROPIC_API_KEY=           # Cattle > Upload reads PDF/photo receipts; use a NEW key
# TELEGRAM_BOT_TOKEN=          # alerts; without it nothing is sent
# --- website ---
SITE_URL=https://www.camcow.com.kh
# --- image tags loaded on this server ---
APP_TAG=latest
WEBSITE_TAG=latest
