{
  "name": "cc-livestock",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:all": "bash scripts/dev-all.sh",
    "server": "npx tsx src/server/index.ts",
    "seed": "npx tsx src/db/seed.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:db": "RUN_DB_TESTS=1 vitest run src/db",
    "restore-db": "npx tsx src/db/migrations/init-db.ts",
    "safe-migrate": "npx tsx src/db/migrate.ts",
    "clear-db": "npx tsx src/db/migrations/clear-production-db.ts",
    "clear-stock": "npx tsx src/db/migrations/clear-stock-only.ts",
    "deploy:setup": "bash scripts/deploy-production.sh",
    "hash-passwords": "npx tsx src/db/migrations/hash-existing-passwords.ts",
    "create-admin": "npx tsx src/db/migrations/create-admin.ts",
    "reset-password": "npx tsx src/db/migrations/reset-password.ts",
    "db:check": "npx tsx src/db/migrations/check-data.ts",
    "login-fix": "npx tsx src/db/migrations/login-fix.ts",
    "set-pin": "npx tsx src/db/migrations/set-pin.ts",
    "website:forms-user": "tsx src/db/create-website-forms-user.ts",
    "website:install": "npm --prefix website install",
    "website:dev": "npm --prefix website run dev",
    "website:build": "npm --prefix website run build",
    "website:start": "npm --prefix website run start",
    "website:test": "npm --prefix website test",
    "website:typecheck": "npm --prefix website run typecheck"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@tanstack/react-query": "^5.101.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.17.0",
    "next": "16.2.7",
    "pg": "^8.22.0",
    "pm2": "^7.0.4",
    "qrcode.react": "^4.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.77.0",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.23.1",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/pg": "^8.11.10",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
