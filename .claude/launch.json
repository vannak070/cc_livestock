{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev-attach",
      "url": "http://localhost:3000"
    },
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "api",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "server"
      ],
      "port": 3003
    },
    {
      "name": "camcow-website",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "website",
        "run",
        "dev"
      ],
      "port": 3200
    },
    {
      "name": "website-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "website",
        "run",
        "start"
      ],
      "port": 3200
    }
  ]
}
