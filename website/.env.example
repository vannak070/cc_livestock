# Copy to .env.local and fill in. Never commit .env.local.

# Folder with the public snapshot published by CC Livestock (latest.json + photos/).
# Leave it out to use ../.website-snapshot (CC Livestock's folder, since this app lives in CC_Livestock/website).
# CAMCOW_SNAPSHOT_DIR=/path/to/.website-snapshot

# Insert-only database account for the Join and price forms.
# Create it in CC Livestock: WEBSITE_FORMS_DB_PASSWORD=... npm run website:forms-user
FORMS_DATABASE_URL=postgres://camcow_website:PASSWORD@localhost:5433/livestock_db

# This website's own address (share links, sitemap).
SITE_URL=http://localhost:3200
