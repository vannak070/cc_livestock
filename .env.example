# Application Server Configuration
PORT=3001
NODE_ENV=development
# Websites allowed to call the API from a browser (comma separated, e.g. https://farm.example.com). In production leave it
# unset (no other website may) or list your own address; "*" is only for development. See docs/production-security.md.
CORS_ORIGIN=*
# Which proxy in front of the API is believed about the caller's address (used for the PIN lockout). Default "loopback"
# (nginx on the same machine). Use a number of hops, or an address range, if the proxy is elsewhere.
# TRUST_PROXY=loopback

# PostgreSQL Database Configuration
# NOTE inside Docker containers, use DB_HOST=db (the Docker Compose service name)
# NOTE for local development outside Docker, use DB_HOST=localhost
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres123
DB_NAME=cc_livestock
DB_SSL=false

# Connection Pool Settings
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONN_TIMEOUT_MS=5000

# Optional: path to a personal Excel workbook to auto-import cattle data from
# on `npm run restore-db`. Leave unset to skip Excel import entirely and use
# db.json / the database as-is.
# EXCEL_IMPORT_PATH=/path/to/Sale Tracking.xlsx

# Secret used to sign login session tokens (JWT). Generate a real random
# value per environment, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Required in production — the server refuses to start without it there.
JWT_SECRET=

# Mark the login cookie Secure (sent over HTTPS only). Set to true as soon as the site has HTTPS; left empty it follows
# the request. Never "false" on a live site.
# SESSION_COOKIE_SECURE=true

# Reading cattle receipts (PDF/photo) on the Cattle page sends the file to Claude. Leave empty to switch it off.
# ANTHROPIC_API_KEY=

# Public address of the deployed app (e.g. https://farm.example.com). The Share
# app QR code and link use it instead of the address the page was opened from.
# Optional; baked in at build time (NEXT_PUBLIC_*), so set it before `npm run build`.
# NEXT_PUBLIC_APP_URL=

# Telegram bot for sale-review alerts (create one with @BotFather). Leave empty to switch alerts off.
TELEGRAM_BOT_TOKEN=

# Shared secret between CC Livestock and the public website: the website's server sends it as CAMCOW_API_KEY to
# /api/v1/site (see docs/website/api-link.md). 32+ characters, e.g.: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Leave empty to switch the website gateway off.
WEBSITE_API_KEY=
